# =============================================================================
# DATABASE - Supabase PostgreSQL
# =============================================================================
# Get from: https://supabase.com > Your Project > Settings > Database > Connection string
# Use "Transaction" mode pooler for DATABASE_URL
# Use "Session" mode for DIRECT_URL (required for migrations)

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# =============================================================================
# SUPABASE
# =============================================================================
# Get from: https://supabase.com > Your Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Storage buckets (create these in Supabase Dashboard > Storage)
SUPABASE_STORAGE_BUCKET_PUBLIC="campaign-assets"
SUPABASE_STORAGE_BUCKET_PRIVATE="user-uploads"

# =============================================================================
# AUTHENTICATION - NextAuth.js
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="https://your-app-url.vercel.app"

# Google OAuth - https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Facebook OAuth - https://developers.facebook.com/apps
AUTH_FACEBOOK_ID="your-facebook-app-id"
AUTH_FACEBOOK_SECRET="your-facebook-app-secret"

# =============================================================================
# CORS + EMBED
# =============================================================================
# Comma-separated list of allowed origins for public API endpoints.
# Example: "https://your-app-url.vercel.app,http://localhost:3000"
ALLOWED_ORIGINS="https://your-app-url.vercel.app"

# Allowed origin for embed assets. Use "*" to allow all.
EMBED_ALLOWED_ORIGINS="*"

# =============================================================================
# RATE LIMITING - Upstash / Vercel KV
# =============================================================================
# Upstash REST credentials (preferred)
UPSTASH_REDIS_REST_URL="https://your-upstash-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Vercel KV REST credentials (alternative)
KV_REST_API_URL="https://your-vercel-kv-url"
KV_REST_API_TOKEN="your-vercel-kv-token"

# =============================================================================
# MONITORING - Sentry
# =============================================================================
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# =============================================================================
# EMAIL - Resend
# =============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# CIVIC INFO - Representative Lookup
# =============================================================================
# OpenStates API key for state legislator lookups (federal data is bundled statically)
# Get a free key at: https://openstates.org/accounts/login/
# To refresh the bundled congress data: npm run congress:update
OPENSTATES_API_KEY="your-openstates-api-key"

# =============================================================================
# CRON JOBS
# =============================================================================
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"
