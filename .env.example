# =============================================================================
# DATABASE - Supabase PostgreSQL
# =============================================================================
# Get from: https://supabase.com > Your Project > Settings > Database > Connection string
# Use "Transaction" mode pooler for DATABASE_URL
# Use "Session" mode for DIRECT_URL (required for migrations)

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Storage buckets (create these in Supabase Dashboard > Storage)
SUPABASE_STORAGE_BUCKET_PUBLIC="campaign-assets"
SUPABASE_STORAGE_BUCKET_PRIVATE="user-uploads"
