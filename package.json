    "scorecard:ingest-current-candidates": "npx tsx ./scripts/ingest-current-candidates.ts",
    "scorecard:attribute-ie-beneficiary": "npx tsx ./scripts/attribute-ie-beneficiary.ts",
    "scorecard:ingest-dime": "npx tsx ./scripts/ingest-dime-recipients.ts",
    "prisma:mock": "npx prisma migrate reset && npx tsx ./scripts/createMockUsers.ts",
    "congress:update": "npx tsx scripts/update-congress-data.ts",
    "ca-legislators:update": "npx tsx scripts/update-ca-legislators.ts",
    "prisma:studio": "npx prisma studio",
    "prepm2": "npm run build",
    "pm2": "pm2 start next --name 'our-power' -- start -p 3000",
    "scorecard:recache-pac": "npx tsx ./scripts/recache-pac-scores.ts",
    "design:contrast": "node ./scripts/check-contrast.mjs",
    "scorecard:backfill-commitments": "npx tsx ./scripts/backfill-plank-commitments.ts",
    "seed:demo-feed": "npx tsx ./scripts/seed-demo-feed-posts.ts",
    "db:prune": "npx tsx ./scripts/prune-database.ts",
    "scorecard:freeze-money": "npx tsx ./scripts/freeze-money-cache.ts"
  },
