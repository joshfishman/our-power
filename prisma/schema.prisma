datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  // Do not change the `id` field, it must be permanent and immutable.
  id                 String              @id @default(cuid())
  // The `username` can be updated anytime by the user.
  // It will acquire the `id` as its default value.
  username           String?             @unique
  email              String?             @unique
  name               String?
  gender             Gender?
  birthDate          DateTime?
  phoneNumber        String?
  address            String?
  bio                String?
  website            String?
  relationshipStatus RelationshipStatus?
  emailVerified      DateTime?
  image              String?
  accounts           Account[]
  sessions           Session[]
  profilePhoto       String?
  coverPhoto         String?
  post               Post[]
  visualMedia        VisualMedia[]
  postLikes          PostLike[]
  comments           Comment[]
  commentLikes       CommentLike[]
  followers          Follow[]            @relation("following")
  following          Follow[]            @relation("follower")
  activities         Activity[]          @relation("activity")
  notifications      Activity[]          @relation("notification")

  // Our Power specific fields
  zipCode              String?
  city                 String?
  state                String?
  streetAddress        String?
  onboardingComplete   Boolean               @default(false)
  causes               Cause[]               @relation("UserCauses")
  managedOrganizations Organization[]        @relation("OrgManagers")
  campaignMemberships  CampaignMember[]
  actionParticipations ActionParticipation[]

  // Cached representative lookup results
  cachedRepresentatives Json?
  repsLookedUpAt        DateTime?
  repsLookupAddress     String?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Follow {
  id          Int    @id @default(autoincrement())
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId])
}

model Post {
  id          Int           @id @default(autoincrement())
  content     String?
  createdAt   DateTime      @default(now())
  visualMedia VisualMedia[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  postLikes   PostLike[]
  comments    Comment[]

  // Optional campaign relation - posts can be associated with campaigns
  campaign   Campaign? @relation("CampaignPosts", fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int

  @@unique([userId, postId])
}

model Comment {
  id           Int           @id @default(autoincrement())
  content      String
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  commentLikes CommentLike[]

  // If there is a `postId`, it is a comment
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  // If there is a `parentId`, it is a reply
  parent   Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?

  // Self-referential relation
  replies Comment[] @relation("Replies")
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int

  @@unique([userId, commentId])
}

model VisualMedia {
  id         Int             @id @default(autoincrement())
  type       VisualMediaType @default(PHOTO)
  fileName   String
  uploadedAt DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  post       Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
}

// This Activity model is similar to this approach: https://stackoverflow.com/a/1766371/8434369
// Example:
// * If the activity type is 'CREATE_COMMENT', the `sourceId` must be the `id` of the Comment and
// its `targetId` must be the `id` of the Post that was commented on.
//
// * If the activity type is 'POST_LIKE', the `sourceId` must be the `id` of the PostLike and
// its `targetId` must be the `id` of the liked Post.
//
// * If the activity type is 'COMMENT_MENTION', the `sourceId` must be the `id` of the Comment and
// its `targetId` must be the `id` of the Post that was commented on.
model Activity {
  id                   Int          @id @default(autoincrement())
  createdAt            DateTime     @default(now())
  type                 ActivityType
  sourceId             Int
  targetId             Int?
  sourceUser           User         @relation("activity", fields: [sourceUserId], references: [id], onDelete: Cascade)
  sourceUserId         String
  targetUser           User         @relation("notification", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId         String
  isNotificationActive Boolean      @default(true)
  isNotificationRead   Boolean      @default(false)

  @@index([targetUserId, createdAt])
  @@index([targetUserId, isNotificationRead])
}

enum ActivityType {
  CREATE_FOLLOW // CREATE_FOLLOW does not use a `targetId`, only `targetUserId`

  POST_LIKE
  POST_MENTION // POST_MENTION does not use a `targetId`, only `targetUserId`

  CREATE_COMMENT
  COMMENT_MENTION
  COMMENT_LIKE

  CREATE_REPLY
  REPLY_MENTION
  REPLY_LIKE

  // Our Power activity types
  CAMPAIGN_JOIN        // User joined a campaign
  ACTION_RSVP          // User RSVP'd to an action
  ACTION_COMPLETED     // User completed an action
  ACTION_REMINDER      // Reminder for upcoming action
}

enum VisualMediaType {
  PHOTO
  VIDEO
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
}

enum RelationshipStatus {
  SINGLE
  IN_A_RELATIONSHIP
  ENGAGED
  MARRIED
}

// =============================================================================
// OUR POWER - ACTIVISM PLATFORM MODELS
// =============================================================================

model Organization {
  id          String     @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  imageUrl    String?    // Cover/banner image
  website     String?
  managers    User[]     @relation("OrgManagers")
  campaigns   Campaign[]

  // Common Ground partnership (per partner-pitch brief, slide 08).
  // null = not a formal Common Ground partner (default for any org in the
  // platform that isn't part of the movement coalition). USER, AFFILIATE,
  // ANCHOR map to the brief's three tiers.
  cgPartnerTier            CgPartnerTier?
  cgPartnerTierAssignedAt  DateTime?
  // Free-form per-tier commitments (e.g. plank focus, Promise Day cadence).
  // Schema deliberately loose so brief refinements don't require migrations.
  cgPartnerCommitments     Json?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([cgPartnerTier])
}

// Common Ground partnership tiers, per partner-pitch brief slide 08.
enum CgPartnerTier {
  USER       // open-license access. No commitments expected.
  AFFILIATE  // public endorsement + one Promise Day per quarter.
  ANCHOR     // staff time + seat on coordinating council.
}

model Cause {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  icon        String? // Icon name or URL
  color       String? // Hex color for UI
  users       User[]     @relation("UserCauses")
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  type        CampaignType
  status      CampaignStatus @default(ACTIVE)
  imageUrl    String?
  startDate   DateTime?
  endDate     DateTime?

  // Relations
  cause   Cause            @relation(fields: [causeId], references: [id])
  causeId String
  org     Organization     @relation(fields: [orgId], references: [id])
  orgId   String
  actions Action[]
  members CampaignMember[]
  posts   Post[]           @relation("CampaignPosts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orgId, createdAt])
}

enum CampaignType {
  LEGISLATIVE // Focused on passing or blocking legislation
  FISCAL // Budget and funding related
  CRIMINAL_JUSTICE // Justice reform related
  ELECTORAL // Election related
  COMMUNITY // Community organizing
  OTHER
}

enum CampaignStatus {
  DRAFT // Not yet published
  ACTIVE // Currently accepting participants
  PAUSED // Temporarily paused
  COMPLETED // Successfully completed
  ARCHIVED // No longer active
}

model Action {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  type        ActionType
  dueDate     DateTime
  isActive    Boolean    @default(true)

  // EVENT type fields
  location     String?
  eventTime    DateTime?
  eventEndTime DateTime?
  locationUrl  String? // Google Maps or venue link

  // PHONE type fields
  callScript   String?  @db.Text
  phoneNumbers String[] // Target phone numbers

  // EMAIL type fields
  emailSubject String?
  emailBody    String?  @db.Text
  emailTargets String[] // Target email addresses

  // Support targeting (PHONE/EMAIL)
  targetMode    ActionTargetMode?
  targetLevel   ActionTargetLevel?
  targetOffices String[]
  manualTargets Json?

  // CANVASS type fields
  canvassArea          String? // Description of area
  canvassTurf          Json? // GeoJSON or turf boundaries
  ecanvasserCampaignId String? // Linked Ecanvasser campaign

  // Shareable content
  graphics  String[] // URLs to shareable images
  shareText String? // Suggested share text

  // Relations
  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  participants ActionParticipation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ActionType {
  EVENT // Show up at a physical location
  PHONE // Phone banking / calling
  EMAIL // Email campaign
  CANVASS // Door-to-door canvassing
}

enum ActionTargetMode {
  CIVIC
  MANUAL
  BOTH
}

enum ActionTargetLevel {
  LOCAL
  STATE
  FEDERAL
}

model ActionParticipation {
  id          String    @id @default(cuid())
  willAttend  Boolean   @default(false) // RSVP'd yes
  attended    Boolean   @default(false) // Actually participated
  completedAt DateTime? // When they completed
  notes       String? // User notes

  // Relations
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, actionId])
}

model CampaignMember {
  id   String     @id @default(cuid())
  role MemberRole @default(MEMBER)

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  joinedAt DateTime @default(now())

  @@unique([userId, campaignId])
}

enum MemberRole {
  MEMBER // Regular campaign member
  ORGANIZER // Can create/edit actions
  ADMIN // Full campaign admin
}

// =====================================================
// Scorecard system
// =====================================================
// Five-plank cross-partisan scorecard rating sitting members of Congress
// (and CA state legislators in v1) against legislative voting records,
// cosponsorships, and corporate PAC money. Federal and state share the
// same models; rows are namespaced by `jurisdiction`.
//
// Methodology rules locked in:
//   - Federal scoring is /25 across 5 planks; state (CA) is /20 across 4
//     planks (Plank 5 "Peace and Strength" doesn't map to state level).
//   - Option C two-tier markers: Republican-authored alternatives may
//     count as SECONDARY markers (never PRIMARY) when introduced as a
//     standalone bill with 3+ GOP cosponsors and directionally aligned
//     with the plank. See `Marker.isRepublicanAlternative` and
//     `Marker.parallelMarkerId`.
//   - Every score must trace to a public source via MarkerAchievement.
//     evidenceSourceUrl. Human verification required before publication.

enum Jurisdiction {
  FEDERAL
  CA
}

enum Chamber {
  SEN // U.S. Senate or CA State Senate
  REP // U.S. House or CA State Assembly
}

enum Party {
  D
  R
  I // Independent / other
}

enum MarkerType {
  PRIMARY
  SECONDARY
}

enum BillType {
  // Federal
  SENATE_BILL
  HOUSE_BILL
  SENATE_JOINT_RES
  HOUSE_JOINT_RES
  SENATE_RES
  HOUSE_RES
  // Concurrent resolutions — used for War Powers Resolutions, which need
  // both chambers but not the President (Plank 5 primary marker).
  SENATE_CONCURRENT_RES
  HOUSE_CONCURRENT_RES
  // California
  CA_ASSEMBLY_BILL
  CA_SENATE_BILL
  CA_ASSEMBLY_RESOLUTION
  CA_SENATE_RESOLUTION
}

enum BillActionType {
  COSPONSOR // Federal cosponsorship
  VOTE_YES
  VOTE_NO
  SPONSOR
  // California-specific authorship tiers
  AUTHOR
  PRINCIPAL_COAUTHOR
  COAUTHOR
}

enum EvidenceType {
  COSPONSOR
  VOTE
  FEC_FILING
  CAL_ACCESS_FILING
  PUBLIC_STATEMENT
}

/// Three-state position record per (legislator, marker). Absence of a
/// MarkerAchievement row means NO_RECORD — we don't know their position.
/// Per We the People methodology v1.1: rendering distinguishes ✓/✗/? so
/// legislators with thin data don't get treated as opposition by default.
enum AchievementStatus {
  ACTED_FOR // Cosponsored / voted yes on the marker bill, or under the corporate-PAC threshold
  ACTED_AGAINST // Voted no on a marker that requires VOTE_YES, or above the corporate-PAC threshold
  NO_RECORD // Explicitly written when we know the legislator was eligible but data was absent (rare; usually just no row)
}

/// Sponsorship tier per LegiScan. Recorded on MarkerAchievement so the
/// page can render different badges for authors vs rank-and-file
/// cosponsors. Mirrors the SponsorTier TS type in the source clients.
enum SponsorTier {
  AUTHOR // Primary sponsor / federal "lead sponsor" / CA principal author
  PRINCIPAL_COAUTHOR // CA: joint sponsor distinct from principal author
  COAUTHOR // CA: regular coauthor
  COSPONSOR // Federal: cosponsor
  SPONSOR // Generic / single-sponsor bills
}

/// Per-cycle race outcome for a candidate, used to track opponents (B+C in the
/// v1.4 methodology). DECLARED_PENDING covers active-cycle candidates who've
/// filed paperwork but the election hasn't happened yet.
enum RaceOutcome {
  WON
  LOST_GENERAL
  LOST_PRIMARY
  DECLARED_PENDING
}

enum PacDataSource {
  OPENSECRETS_BULK // OpenSecrets bulk CSV (federal)
  CAL_ACCESS_CCDC // CCDC Big Local News exports (CA)
  FEC_DIRECT // Future graduation path: FEC.gov api.open.fec.gov
}

enum CommitteeCategory {
  CORPORATE
  LABOR
  IDEOLOGICAL
  PARTY
  CANDIDATE // Candidate-controlled committee
  TRADE_ASSOCIATION
  UNCLASSIFIED
}

model Plank {
  id               String       @id @default(cuid())
  jurisdiction     Jurisdiction
  slug             String
  number           Int // 1-5 (federal) / 1-4 (CA)
  name             String
  shortDescription String       @db.Text
  tagline          String       @db.Text
  body             String       @db.Text // Full plank text per the brief
  color            String? // Hex accent color for UI

  markers Marker[]
  scores  RepresentativeScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jurisdiction, slug])
  @@unique([jurisdiction, number])
  @@index([jurisdiction])
}

model Marker {
  id                      String       @id @default(cuid())
  plank                   Plank        @relation(fields: [plankId], references: [id], onDelete: Cascade)
  plankId                 String
  jurisdiction            Jurisdiction // Denormalized from Plank for query convenience; must match plank.jurisdiction
  slug                    String
  name                    String
  markerType              MarkerType
  description             String       @db.Text
  methodologyNotes        String?      @db.Text
  displayOrder            Int          @default(0)
  // Option C two-tier marker support
  isRepublicanAlternative Boolean      @default(false)
  parallelMarker          Marker?      @relation("ParallelMarker", fields: [parallelMarkerId], references: [id])
  parallelMarkerId        String?
  parallels               Marker[]     @relation("ParallelMarker")

  bills        MarkerBill[]
  achievements MarkerAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plankId, slug])
  @@index([jurisdiction])
  @@index([plankId])
}

model MarkerBill {
  id                String         @id @default(cuid())
  marker            Marker         @relation(fields: [markerId], references: [id], onDelete: Cascade)
  markerId          String
  congressNumber    Int // 119 for federal current; CA session encoded as e.g. 20232024
  billType          BillType
  billNumber        String // e.g. "S.1041" or "AB-2200"
  billTitle         String
  actionType        BillActionType // What achieves this marker via this bill
  notes             String?        @db.Text
  isProvisional     Boolean        @default(true) // Bill numbers must be verified vs. authoritative source before any sync runs
  // External system identifiers
  legiscanBillId    Int?           @unique // LegiScan's bill_id, populated by sync
  // Public-facing fields for the per-bill issue page
  publicSlug        String?        @unique // Shareable URL slug, e.g. "calcare"
  publicDescription String?        @db.Text // Human-readable explainer rendered on the issue page
  statusNote        String?        @db.Text // e.g. "Held in Assembly Health Committee, did not advance"
  callToAction      String?        @db.Text // Phone script body for the "call your rep" CTA
  isFeatured        Boolean        @default(false) // Surfaced on the scorecard index when featured

  /// Ordered timeline of bill actions ("Read first time", "Referred to Com. on HEALTH",
  /// "Held under submission", etc.). Populated by sync from LegiScan's `history` array.
  /// Shape: [{ date: string, chamber: 'A'|'S'|'X', action: string }, ...]
  /// We store as JSON rather than a separate table because the timeline is always
  /// rendered together and never queried individually.
  procedureHistory  Json?

  votes        BillVote[]
  sponsorships BillSponsorship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([markerId, billType, billNumber])
  @@index([markerId])
  @@index([isFeatured])
}

enum VotePosition {
  YES
  NO
  NOT_VOTING
  EXCUSED
  PRESENT // Voted "present" — counted but not yes/no
  ABSTAINED
}

model BillVote {
  id           String       @id @default(cuid())
  bill         MarkerBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId       String
  legislator   Legislator   @relation(fields: [legislatorId], references: [id], onDelete: Cascade)
  legislatorId String
  position     VotePosition
  voteDate     DateTime?
  voteContext  String? // e.g. "Floor vote", "Committee on Health, 2024-01-11"
  sourceUrl    String? // Permanent link back to the official roll record
  isProvisional Boolean    @default(true) // Mirror MarkerBill provisionality — votes need source verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billId, legislatorId, voteContext])
  @@index([billId])
  @@index([legislatorId])
}

// v1.6 — roll-call-alignment methodology.
//
// Replaces the v1.5 marker-based scoring with "% of plank-relevant votes
// where the legislator voted with the platform-preferred direction."
// Same approach as LCV, ACU, AFL-CIO scorecards.
//
// One RollCallVote row per (chamber, congress, session, rollcall-number).
// One RollCallPosition row per (vote, legislator).
// Classification happens at the RollCallVote level — which plank(s) does
// this vote relate to, and what's the platform-aligned position?
enum RollCallChamber {
  HOUSE
  SENATE
  CA_ASSEMBLY
  CA_SENATE
}

model RollCallVote {
  id              String          @id @default(cuid())
  chamber         RollCallChamber
  congressNumber  Int // 119 for federal current; CA session encoded as e.g. 20232024
  sessionNumber   Int // 1 or 2 for federal; 1 for CA
  rollCallNumber  Int // sequential within (chamber, congress, session)
  voteDate        DateTime
  voteQuestion    String // e.g. "On Passage", "On Motion to Suspend the Rules and Pass"
  voteResult      String // "Passed" / "Failed" / "Agreed To"
  voteType        String // e.g. "Yea-And-Nay", "2/3 Yea-And-Nay"

  // Bill / resolution linkage (null when vote isn't tied to a bill — e.g.
  // election of the speaker, censure, motion to table without a target).
  billType        String? // HR / S / HJRES / SJRES / HCONRES / etc.
  billNumber      String?
  billTitle       String? // Bill official short title (cached from Congress.gov)
  billPolicyArea  String? // Congress.gov policy-area label, e.g. "Energy"
  billSubjects    Json? // Array<string> of Congress.gov legislative-subject tags
  billSponsorParty String? // 'D' / 'R' / 'I' — needed for aligned-position inference
  billSponsorBioguide String? // bioguide id of first listed sponsor

  // v1.6 plank classification — one vote can hit multiple planks.
  // Empty array = "not plank-relevant" (procedural / off-topic) and the
  // vote contributes nothing to any score.
  plankNumbers    Int[]
  alignedPosition VotePosition? // YES or NO — what counts as platform-aligned
  classificationConfidence  Float? // 0.0-1.0; LLM-reported (when LLM-classified)
  classificationSource      String  @default("auto") // 'auto' | 'human' | 'auto-then-human'
  classificationReasoning   String? @db.Text
  classifiedAt              DateTime?
  classifiedBy              String? // 'llm-claude-sonnet-4' | reviewer ID
  reviewedAt                DateTime?
  reviewedBy                String?

  // Procedural-vote filter. Substantive votes (On Passage, etc.) get
  // isScorable=true after classification. Procedural votes (Previous
  // Question, Motion to Table, etc.) get false and don't drive scoring.
  isScorable      Boolean @default(false)

  sourceUrl       String? // Permalink to the roll-call detail

  positions       RollCallPosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chamber, congressNumber, sessionNumber, rollCallNumber])
  @@index([plankNumbers], type: Gin)
  @@index([chamber, congressNumber])
  @@index([classifiedAt])
  @@index([isScorable])
}

model RollCallPosition {
  id           String       @id @default(cuid())
  vote         RollCallVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId       String
  legislator   Legislator   @relation(fields: [legislatorId], references: [id], onDelete: Cascade)
  legislatorId String
  position     VotePosition

  createdAt DateTime @default(now())

  @@unique([voteId, legislatorId])
  @@index([legislatorId])
  @@index([voteId])
}

model Legislator {
  // Primary key is bioguideId for federal, openStatesId for CA.
  // We use a generic cuid id to keep the model uniform; bioguideId/openStatesId are unique secondary keys.
  id            String       @id @default(cuid())
  jurisdiction  Jurisdiction
  bioguideId       String?      @unique // Federal members of Congress
  openStatesId     String?      @unique // CA state legislators (and any other state expansion later)
  legiscanPeopleId Int?         @unique // LegiScan's people_id (federal + state)
  firstName     String
  lastName      String
  fullName      String
  chamber       Chamber
  state         String // 2-letter state abbreviation
  district      Int? // null for U.S. Senate; required for U.S. House and state legislatures
  party         Party
  // Cross-system identifiers (federal)
  opensecretsId String? // OpenSecrets CID
  fecIds        String[] // FEC committee IDs (sometimes multiple)
  govtrackId    Int?
  photoUrl      String?
  isActive      Boolean      @default(true)

  scores       RepresentativeScore[]
  achievements MarkerAchievement[]
  pacData      PacMoneyData[]
  races        RaceCandidate[]
  billVotes        BillVote[]
  billSponsorships BillSponsorship[]
  rollCallPositions RollCallPosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jurisdiction])
  @@index([state, chamber])
  @@index([state, chamber, district])
}

model RepresentativeScore {
  id                  String   @id @default(cuid())
  legislator          Legislator @relation(fields: [legislatorId], references: [id], onDelete: Cascade)
  legislatorId        String
  plank               Plank    @relation(fields: [plankId], references: [id], onDelete: Cascade)
  plankId             String
  score               Int // signed integer under methodology v1.2 (+/-)
  // For/against counts stored alongside the score so the index page can
  // render "+N · X for · Y against" from a single source of truth. The
  // invariant `score = forCount - againstCount` must hold; both are
  // written atomically by compute-scores.
  forCount            Int      @default(0)
  againstCount        Int      @default(0)
  computedAt          DateTime @default(now())
  methodologyVersion  String // e.g. "v1.0"
  notes               String?  @db.Text
  publishedAt         DateTime? // null = unpublished/internal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([legislatorId, plankId, methodologyVersion])
  @@index([legislatorId])
  @@index([plankId])
}

/// Per-(bill, legislator) sponsor record. Distinguishes "sponsored
/// AB-1900" from "sponsored AB-2200" — MarkerAchievement is per-marker
/// and can't distinguish which specific bill triggered the credit. The
/// CalCare bill page uses these rows to render Authors / Cosponsors
/// sections with full attribution per bill.
model BillSponsorship {
  id               String      @id @default(cuid())
  bill             MarkerBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId           String
  legislator       Legislator  @relation(fields: [legislatorId], references: [id], onDelete: Cascade)
  legislatorId     String
  sponsorTier      SponsorTier
  rawSponsorTypeId Int? // LegiScan sponsor_type_id, for audit
  sponsorOrder     Int? // LegiScan sponsor_order (1 = primary, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billId, legislatorId])
  @@index([billId])
  @@index([legislatorId])
}

model MarkerAchievement {
  id                String              @id @default(cuid())
  legislator        Legislator          @relation(fields: [legislatorId], references: [id], onDelete: Cascade)
  legislatorId      String
  marker            Marker              @relation(fields: [markerId], references: [id], onDelete: Cascade)
  markerId          String
  achieved          Boolean // Retained for back-compat with scoring engine; derived from actionTaken
  // Three-state position evidence — distinguishes "took the right side"
  // from "took the wrong side" from "no public record yet" so legislators
  // with limited data don't get penalized as if they opposed everything.
  // Absence of a row is the implicit fourth state: NO_RECORD.
  actionTaken       AchievementStatus?  // null = legacy row written before three-state rollout
  // When the achievement comes from sponsorship (rather than a vote),
  // record the sponsor tier so the page can render an "Author" or
  // "Cosponsor" badge. Null when the achievement comes from a vote roll
  // or PAC data.
  sponsorTier       SponsorTier?
  evidenceType      EvidenceType
  evidenceSourceUrl String? // Public link the score traces to
  evidenceNotes     String?             @db.Text
  // v1.4 continuous marker score (currently used for PAC marker only — null for all
  // other achievement types). Scoring engine prefers this over the v1.3 integer
  // weight when present.
  achievementScore  Decimal?            @db.Decimal(6, 2)
  verifiedAt        DateTime?
  verifiedBy        String? // User id or admin email; resolved at app layer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([legislatorId, markerId])
  @@index([legislatorId])
  @@index([markerId])
  @@index([actionTaken])
}

model PacMoneyData {
  id                     String        @id @default(cuid())
  legislator             Legislator    @relation(fields: [legislatorId], references: [id], onDelete: Cascade)
  legislatorId           String
  cycleYear              Int // e.g. 2026
  corporatePacAmount     Decimal       @db.Decimal(14, 2)
  totalReceipts          Decimal       @db.Decimal(14, 2)
  corporatePacPercentage Decimal       @db.Decimal(6, 4) // Stored as 0.0000-1.0000 for precision
  // v1.4 IE breakdown (nullable; default 0 in queries). corporateIeAgainstSelfAmount
  // is disclosed in the PAC scoreboard but does NOT count toward the combined ratio.
  corporateIeSupportAmount          Decimal?      @db.Decimal(14, 2)
  corporateIeAgainstOpponentAmount  Decimal?      @db.Decimal(14, 2)
  corporateIeAgainstSelfAmount      Decimal?      @db.Decimal(14, 2)
  // Cached v1.4 ratio: (direct corp + IE for + IE vs opponent) / (total receipts + same IE).
  combinedCorporateRatio            Decimal?      @db.Decimal(6, 4)
  dataSource             PacDataSource
  dataSourceUrl          String? // Link back to the underlying filing or summary
  fetchedAt              DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Allows multiple rows per legislator-cycle from different sources;
  // scoring engine prefers higher-fidelity sources (CAL_ACCESS_CCDC > OPENSECRETS_BULK)
  @@unique([legislatorId, cycleYear, dataSource])
  @@index([legislatorId])
  @@index([cycleYear])
}

/// Tracks every candidate who has run (or is currently running) for a
/// legislator's seat, across cycles. Used by v1.4's "money working for me"
/// ratio to count corporate IE spending against the legislator's opponents.
/// Indexed for "who ran against legislator X in cycle Y" lookups.
model RaceCandidate {
  id                   String        @id @default(cuid())
  legislator           Legislator?   @relation(fields: [legislatorId], references: [id], onDelete: SetNull)
  legislatorId         String?
  cycleYear            Int
  jurisdiction         Jurisdiction
  state                String
  chamber              Chamber
  district             Int?
  externalCandidateId  String
  candidateName        String
  outcome              RaceOutcome

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleYear, externalCandidateId])
  @@index([cycleYear, jurisdiction, state, chamber, district])
}

/// Stores the per-methodology-version percentile anchors used to map raw signed
/// scores to the -100% to +100% display range. Written once per methodology
/// version by compute-scores after the first run. Frozen until the next
/// methodology bump.
model ScoreCalibration {
  id                 String   @id @default(cuid())
  methodologyVersion String   @unique
  positiveAnchor     Decimal  @db.Decimal(8, 2)
  negativeAnchor     Decimal  @db.Decimal(8, 2)
  computedAt         DateTime @default(now())
  computedFromCount  Int
}

model CommitteeClassification {
  id            String            @id @default(cuid())
  jurisdiction  Jurisdiction
  committeeId   String // FEC committee ID for federal, Cal-Access filer ID for CA
  committeeName String
  category      CommitteeCategory
  /// v1.5 — funding-model classification used by the scoring engine.
  /// MONEY = concentrated-wealth-funded (corporate / leadership-establishment /
  /// donor-class / party committees). PEOPLE = grassroots-funded (member dues,
  /// small-dollar mass contribution, worker organizations). The MONEY bucket
  /// is what counts negatively against legislators on Plank 1. Defaults to
  /// MONEY for conservative-attribution under v1.5.
  motivationClass MotivationClass @default(MONEY)
  sponsorName   String? // Sponsor org for sponsored committees (CA FPPC)
  sourceNotes   String?           @db.Text // Public reasoning for the classification call
  classifiedBy  String? // Reviewer identifier
  classifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jurisdiction, committeeId])
  @@index([jurisdiction, category])
  @@index([jurisdiction, motivationClass])
}

/// v1.5 binary classification: is this committee funded by concentrated
/// wealth seeking access (MONEY) or by grassroots / members / workers
/// (PEOPLE)? Replaces the v1.4 corporate-vs-non-corporate distinction.
enum MotivationClass {
  MONEY
  PEOPLE
}

enum ApiCallSource {
  LEGISCAN
  CONGRESSGOV
  OPENSTATES
  OPENSECRETS_BULK
  CAL_ACCESS_CCDC
  FEC_DIRECT
}

// Records every external data call made by the scorecard pipeline.
// Lets us audit rate limit budget, debug failures, and verify caching
// is doing its job. Older rows are pruned by a maintenance job.
model ApiCallLog {
  id           String        @id @default(cuid())
  source       ApiCallSource
  endpoint     String // e.g. "getBill" or full URL path
  params       Json? // Request parameters (no secrets)
  status       Int? // HTTP status code, null if exception before response
  cacheHit     Boolean       @default(false)
  durationMs   Int? // Round-trip time
  errorMessage String?       @db.Text

  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([endpoint, createdAt])
  @@index([createdAt])
}
