datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  // Do not change the `id` field, it must be permanent and immutable.
  id                 String              @id @default(cuid())
  // The `username` can be updated anytime by the user.
  // It will acquire the `id` as its default value.
  username           String?             @unique
  email              String?             @unique
  name               String?
  gender             Gender?
  birthDate          DateTime?
  phoneNumber        String?
  address            String?
  bio                String?
  website            String?
  relationshipStatus RelationshipStatus?
  emailVerified      DateTime?
  image              String?
  accounts           Account[]
  sessions           Session[]
  profilePhoto       String?
  coverPhoto         String?
  post               Post[]
  visualMedia        VisualMedia[]
  postLikes          PostLike[]
  comments           Comment[]
  commentLikes       CommentLike[]
  followers          Follow[]            @relation("following")
  following          Follow[]            @relation("follower")
  activities         Activity[]          @relation("activity")
  notifications      Activity[]          @relation("notification")

  // Our Power specific fields
  zipCode              String?
  streetAddress        String?
  onboardingComplete   Boolean               @default(false)
  causes               Cause[]               @relation("UserCauses")
  managedOrganizations Organization[]        @relation("OrgManagers")
  campaignMemberships  CampaignMember[]
  actionParticipations ActionParticipation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Follow {
  id          Int    @id @default(autoincrement())
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@unique([followerId, followingId])
}

model Post {
  id          Int           @id @default(autoincrement())
  content     String?
  createdAt   DateTime      @default(now())
  visualMedia VisualMedia[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  postLikes   PostLike[]
  comments    Comment[]

  // Optional campaign relation - posts can be associated with campaigns
  campaign   Campaign? @relation("CampaignPosts", fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int

  @@unique([userId, postId])
}

model Comment {
  id           Int           @id @default(autoincrement())
  content      String
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  commentLikes CommentLike[]

  // If there is a `postId`, it is a comment
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  // If there is a `parentId`, it is a reply
  parent   Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId Int?

  // Self-referential relation
  replies Comment[] @relation("Replies")
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int

  @@unique([userId, commentId])
}

model VisualMedia {
  id         Int             @id @default(autoincrement())
  type       VisualMediaType @default(PHOTO)
  fileName   String
  uploadedAt DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  post       Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     Int
}

// This Activity model is similar to this approach: https://stackoverflow.com/a/1766371/8434369
// Example:
// * If the activity type is 'CREATE_COMMENT', the `sourceId` must be the `id` of the Comment and
// its `targetId` must be the `id` of the Post that was commented on.
//
// * If the activity type is 'POST_LIKE', the `sourceId` must be the `id` of the PostLike and
// its `targetId` must be the `id` of the liked Post.
//
// * If the activity type is 'COMMENT_MENTION', the `sourceId` must be the `id` of the Comment and
// its `targetId` must be the `id` of the Post that was commented on.
model Activity {
  id                   Int          @id @default(autoincrement())
  createdAt            DateTime     @default(now())
  type                 ActivityType
  sourceId             Int
  targetId             Int?
  sourceUser           User         @relation("activity", fields: [sourceUserId], references: [id], onDelete: Cascade)
  sourceUserId         String
  targetUser           User         @relation("notification", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId         String
  isNotificationActive Boolean      @default(true)
  isNotificationRead   Boolean      @default(false)

  @@index([targetUserId, createdAt])
  @@index([targetUserId, isNotificationRead])
}

enum ActivityType {
  CREATE_FOLLOW // CREATE_FOLLOW does not use a `targetId`, only `targetUserId`

  POST_LIKE
  POST_MENTION // POST_MENTION does not use a `targetId`, only `targetUserId`

  CREATE_COMMENT
  COMMENT_MENTION
  COMMENT_LIKE

  CREATE_REPLY
  REPLY_MENTION
  REPLY_LIKE

  // Our Power activity types
  CAMPAIGN_JOIN        // User joined a campaign
  ACTION_RSVP          // User RSVP'd to an action
  ACTION_COMPLETED     // User completed an action
  ACTION_REMINDER      // Reminder for upcoming action
}

enum VisualMediaType {
  PHOTO
  VIDEO
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
}

enum RelationshipStatus {
  SINGLE
  IN_A_RELATIONSHIP
  ENGAGED
  MARRIED
}

// =============================================================================
// OUR POWER - ACTIVISM PLATFORM MODELS
// =============================================================================

model Organization {
  id          String     @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  imageUrl    String?    // Cover/banner image
  website     String?
  managers    User[]     @relation("OrgManagers")
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Cause {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  icon        String? // Icon name or URL
  color       String? // Hex color for UI
  users       User[]     @relation("UserCauses")
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  type        CampaignType
  status      CampaignStatus @default(ACTIVE)
  imageUrl    String?
  startDate   DateTime?
  endDate     DateTime?

  // Relations
  cause   Cause            @relation(fields: [causeId], references: [id])
  causeId String
  org     Organization     @relation(fields: [orgId], references: [id])
  orgId   String
  actions Action[]
  members CampaignMember[]
  posts   Post[]           @relation("CampaignPosts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orgId, createdAt])
}

enum CampaignType {
  LEGISLATIVE // Focused on passing or blocking legislation
  FISCAL // Budget and funding related
  CRIMINAL_JUSTICE // Justice reform related
  ELECTORAL // Election related
  COMMUNITY // Community organizing
  OTHER
}

enum CampaignStatus {
  DRAFT // Not yet published
  ACTIVE // Currently accepting participants
  PAUSED // Temporarily paused
  COMPLETED // Successfully completed
  ARCHIVED // No longer active
}

model Action {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  type        ActionType
  dueDate     DateTime
  isActive    Boolean    @default(true)

  // EVENT type fields
  location     String?
  eventTime    DateTime?
  eventEndTime DateTime?
  locationUrl  String? // Google Maps or venue link

  // PHONE type fields
  callScript   String?  @db.Text
  phoneNumbers String[] // Target phone numbers
  dialerUrl    String? // Deep link to Scale to Win/GetThru

  // EMAIL type fields
  emailSubject String?
  emailBody    String?  @db.Text
  emailTargets String[] // Target email addresses

  // CANVASS type fields
  canvassArea          String? // Description of area
  canvassTurf          Json? // GeoJSON or turf boundaries
  ecanvasserCampaignId String? // Linked Ecanvasser campaign

  // Shareable content
  graphics  String[] // URLs to shareable images
  shareText String? // Suggested share text

  // Relations
  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  participants ActionParticipation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ActionType {
  EVENT // Show up at a physical location
  PHONE // Phone banking / calling
  EMAIL // Email campaign
  CANVASS // Door-to-door canvassing
}

model ActionParticipation {
  id          String    @id @default(cuid())
  willAttend  Boolean   @default(false) // RSVP'd yes
  attended    Boolean   @default(false) // Actually participated
  completedAt DateTime? // When they completed
  notes       String? // User notes

  // Relations
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, actionId])
}

model CampaignMember {
  id   String     @id @default(cuid())
  role MemberRole @default(MEMBER)

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  joinedAt DateTime @default(now())

  @@unique([userId, campaignId])
}

enum MemberRole {
  MEMBER // Regular campaign member
  ORGANIZER // Can create/edit actions
  ADMIN // Full campaign admin
}
