# =============================================================================
# APP URL
# =============================================================================
# Your app's base URL (no trailing slash)
URL=http://localhost:3000

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
# Same as URL
AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# Google OAuth
# Get from: https://console.cloud.google.com > APIs & Services > Credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth  
# Get from: https://developers.facebook.com > Your App > Settings > Basic
# Redirect URI: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Instagram OAuth (uses Facebook Developer portal)
# Get from: https://developers.facebook.com > Your App > Instagram Basic Display
# Redirect URI: http://localhost:3000/api/auth/callback/instagram
AUTH_INSTAGRAM_ID=
AUTH_INSTAGRAM_SECRET=

# GitHub OAuth (optional, already in Munia)
# Get from: https://github.com/settings/developers
# Redirect URI: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# =============================================================================
# CORS + EMBED
# =============================================================================
# Comma-separated list of allowed origins for public API endpoints
ALLOWED_ORIGINS=http://localhost:3000

# Allowed origin for embed assets ("*" to allow all)
EMBED_ALLOWED_ORIGINS=*

# =============================================================================
# RATE LIMITING (Upstash / Vercel KV)
# =============================================================================
# Upstash REST credentials (preferred)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV REST credentials (alternative)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# =============================================================================
# MONITORING - Sentry
# =============================================================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# GOOGLE MAPS - Address Autocomplete (client-side)
# =============================================================================
# Used on the action detail page for address autocomplete (Places API)
# Get from: https://console.cloud.google.com > APIs & Services > Credentials
# Enable: Maps JavaScript API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# CIVIC INFO - Google Civic API
# =============================================================================
# Get from: https://developers.google.com/civic-information
CIVIC_API_KEY=

# =============================================================================
# SUPABASE
# =============================================================================
# Get from: https://supabase.com > Your Project > Settings > API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co

# anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (KEEP SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# STORAGE (Supabase Storage replaces AWS S3)
# =============================================================================
# Bucket names (create these in Supabase Dashboard > Storage)
SUPABASE_STORAGE_BUCKET_PUBLIC=campaign-assets
SUPABASE_STORAGE_BUCKET_PRIVATE=user-uploads

# =============================================================================
# PHASE II - CANVASSING (Ecanvasser)
# =============================================================================
# Get from: https://ecanvasser.com > Account Settings > Public API
# (Email support@ecanvasser.com to enable API access first)
ECANVASSER_API_KEY=
ECANVASSER_API_URL=https://api.ecanvasser.com/v1

# =============================================================================
# PHASE II - PHONE BANKING
# =============================================================================
# Scale to Win - Get campaign URL from your Scale to Win dashboard
# https://www.scaletowin.com
SCALE_TO_WIN_BASE_URL=

# GetThru ThruTalk - Get campaign URL from your GetThru dashboard
# https://www.getthru.io
GETTHRU_BASE_URL=

# =============================================================================
# SCORECARD (LegiScan — federal + state legislation, sponsors, votes)
# =============================================================================
# Register a free myLegiScan account at https://legiscan.com/legiscan
# and copy the API key from your account dashboard. The API requires a
# one-page application that goes through manual review.
# Free tier: 30,000 queries/month (more than enough for marker-bill sync).
LEGISCAN_API_KEY=

# =============================================================================
# SCORECARD — FEC.gov campaign finance API (Plank 1: Honest Government)
# =============================================================================
# FEC publishes per-candidate cycle totals via api.open.fec.gov. Used by
# scripts/ingest-fec.ts to populate PacMoneyData with dataSource=FEC_DIRECT.
#
# Get a free key instantly at https://api.data.gov/signup/ — no application,
# 1000 requests/hour ceiling. Required for `npm run scorecard:ingest-fec`.
# The script also accepts FEC_DATA_API as an alias for this var.
FEC_API_KEY=

# Backup source while LegiScan API approval is pending: point this at a
# directory holding the unzipped LegiScan bulk dataset(s) downloaded from
# https://legiscan.com/datasets (login required, no application). The
# adapter walks the tree and finds bill / vote JSON files automatically;
# layout inside the directory does not matter. Either set this OR
# LEGISCAN_API_KEY — only one source is used per sync run.
LEGISCAN_DATASET_DIR=

# Default sync source when not overridden by the --source CLI flag.
# `api`  — primary path: hit api.legiscan.com (requires LEGISCAN_API_KEY).
#          Real-time, ~80 calls per full sync, well under 30k/mo limit.
# `bulk` — fallback path: read from LEGISCAN_DATASET_DIR.
#          Use only when API is unavailable / offline / for validation
#          against a frozen snapshot.
LEGISCAN_SOURCE=api

# =============================================================================
# CRON JOBS (Vercel Cron)
# =============================================================================
# Secret to authenticate cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=
