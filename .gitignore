# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.vercel

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/

# custom
/public/uploads/data/

# LegiScan / OpenSecrets / Cal-Access dataset dumps (large, keep out of repo).
# /data/ contents are ignored EXCEPT small hand-curated CSV overlays
# (data/manual-*.csv) that need to ship with the repo. Git can only re-
# include children if the parent directory itself isn't fully ignored,
# so we ignore /data/* (contents) rather than /data/ (directory).
/data/*
!/data/manual-*.csv
!/data/pac-candidates.csv
!/data/leadership-pacs-manual.csv
/CA/

# Claude Code / Cursor working directories
/.claude/
/.cursor/

# FEC bulk data files (large, downloadable from fec.gov)
/data/fec-bulk-*/*.txt
/data/fec-bulk-*/*.zip

# Inline classification batches (intermediate; final state is in pac-candidates.csv)
/data/inline-classifications-batch*.json

